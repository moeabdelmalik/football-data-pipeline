# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored - never commit real values.
# ---------------------------------------------------------------------------

# --- Source API -------------------------------------------------------------
# "3" is TheSportsDB public test key. It caps event endpoints to ~5 rows/call.
# Replace with a patron key for full season data - no code change required.
TSDB_API_KEY=3

# --- Google Cloud -----------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=US
GCS_RAW_BUCKET=your-raw-landing-bucket

# Where raw files land when running with --dest local (no GCP needed).
# Gitignored. Mirrors the bucket layout exactly, so the two are interchangeable.
LOCAL_RAW_DIR=data

# Path INSIDE the container. Mount your key at ./secrets/sa.json (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/secrets/sa.json

# --- BigQuery datasets ------------------------------------------------------
BQ_DATASET_RAW=sports_raw
BQ_DATASET_STAGING=sports_staging
BQ_DATASET_MARTS=sports_marts

# --- dbt --------------------------------------------------------------------
DBT_TARGET=dev

# --- Airflow ----------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
